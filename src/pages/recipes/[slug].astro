---
import Base from '../../layouts/Base.astro';
import { formatDate } from '../../lib/posts';
import { getRecipe, renderMarkdoc } from '../../lib/recipes';

const { slug } = Astro.params;
const recipe = slug ? await getRecipe(slug) : null;

if (!recipe) {
  return Astro.rewrite('/404');
}

const html = renderMarkdoc(recipe.content.node);
const facts = [
  { label: 'Servings', value: recipe.servings },
  { label: 'Prep time', value: recipe.prepTime },
  { label: 'Cook time', value: recipe.cookTime },
].filter((fact): fact is { label: string; value: string } => Boolean(fact.value));
---

<Base title={recipe.title} description={recipe.description} canonical={`/recipes/${slug}/`}>
  <article>
    <header class="post-header">
      <a class="back-link" href="/recipes/">← All recipes</a>
      {recipe.publishedAt && (
        <time datetime={recipe.publishedAt}>{formatDate(recipe.publishedAt)}</time>
      )}
      <h1>{recipe.title}</h1>
      {recipe.description && <p>{recipe.description}</p>}

      {
        facts.length > 0 && (
          <dl class="recipe-facts">
            {facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </header>

    <div class="post-body" data-checklist data-storage-key={`ingredient-checks:${slug}`}>
      <h2>Ingredients</h2>
      {
        recipe.ingredients
          .filter((group) => group.items.length > 0)
          .map((group, groupIndex) => (
            <div class="ingredient-group">
              {group.component && <h3>{group.component}</h3>}
              <ul>
                {group.items.map((ingredient, itemIndex) => (
                  <li>
                    <label>
                      <input
                        type="checkbox"
                        data-check-key={`${groupIndex}:${itemIndex}`}
                      />
                      <span>{ingredient}</span>
                    </label>
                  </li>
                ))}
              </ul>
            </div>
          ))
      }
    </div>

    <div
      class="post-body"
      data-method
      data-checklist
      data-storage-key={`step-checks:${slug}`}
      set:html={html}
    />
  </article>
</Base>

<script>
  // Keep check-offs for the current tab only, so a half-finished recipe does
  // not follow the visitor around forever.
  const setupChecklist = (container: HTMLElement) => {
    const storageKey = container.dataset.storageKey;
    if (!storageKey) {
      return;
    }

    const boxes = Array.from(
      container.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'),
    );

    let checked: Record<string, boolean> = {};
    try {
      checked = JSON.parse(sessionStorage.getItem(storageKey) ?? '{}') as Record<
        string,
        boolean
      >;
    } catch {}

    const save = () => {
      const next: Record<string, boolean> = {};
      for (const box of boxes) {
        const key = box.dataset.checkKey;
        if (box.checked && key) {
          next[key] = true;
        }
      }

      try {
        sessionStorage.setItem(storageKey, JSON.stringify(next));
      } catch {}
    };

    for (const box of boxes) {
      box.checked = Boolean(checked[box.dataset.checkKey ?? '']);
      box.addEventListener('change', save);
    }
  };

  // Methods are rendered from Markdoc, so add the step checkboxes here. Only
  // ordered lists are steps; bullet lists (such as notes) are left alone.
  const method = document.querySelector<HTMLElement>('[data-method]');

  if (method) {
    let index = 0;

    for (const item of method.querySelectorAll<HTMLLIElement>('ol > li')) {
      index += 1;

      const box = document.createElement('input');
      box.type = 'checkbox';
      box.className = 'step-check';
      box.dataset.checkKey = String(index - 1);
      box.setAttribute(
        'aria-label',
        `Step ${index}: ${(item.textContent ?? '').trim()}`,
      );

      const text = document.createElement('span');
      text.className = 'step-text';
      while (item.firstChild) {
        text.append(item.firstChild);
      }

      item.append(box, text);
      item.classList.add('step');
    }

    for (const list of method.querySelectorAll('ol')) {
      list.classList.add('steps');
    }
  }

  for (const container of document.querySelectorAll<HTMLElement>('[data-checklist]')) {
    setupChecklist(container);
  }
</script>
