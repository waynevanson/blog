---
import Base from '../layouts/Base.astro';
import { getHome } from '../lib/home';

const home = await getHome();
const paragraphs = home.intro.split(/\n\s*\n/).filter(Boolean);
---

<Base title={home.heading} description={home.intro}>
  <section class="hero">
    <h1>{home.heading}</h1>
    {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </section>

  {
    home.socials.length > 0 && (
      <ul class="social-list">
        {home.socials.map((social) => (
          <li>
            <a href={social.url} rel="me">
              {social.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }

  <p class="more-link"><a href="/posts/">Read the posts →</a></p>
</Base>
