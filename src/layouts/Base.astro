---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
const site = Astro.site ?? new URL('https://blog.waynevanson.com');
const section = Astro.url.pathname.startsWith('/posts')
  ? 'posts'
  : Astro.url.pathname.startsWith('/recipes')
    ? 'recipes'
    : 'home';
const canonicalURL = canonical ? new URL(canonical, site) : new URL(Astro.url.pathname, site);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title === 'Wayne Van Son' ? title : `${title} — Wayne Van Son`}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Wayne Van Son" href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Apply the saved theme (or the system preference) before first paint so
      // the page never flashes the wrong colours.
      (() => {
        const root = document.documentElement;
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {}
        const mode =
          stored === 'light' || stored === 'dark' || stored === 'system'
            ? stored
            : 'system';
        const system = window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light';
        root.dataset.theme = mode === 'system' ? system : mode;
        root.dataset.themeMode = mode;
      })();
    </script>
  </head>
  <body data-section={section}>
    <header class="site-header">
      <a class="wordmark" href="/">Wayne Van Son</a>
      <div class="header-actions">
        <nav>
          <a href="/">Home</a>
          <a href="/posts/">Posts</a>
          <a href="/recipes/">Recipes</a>
        </nav>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle colour theme">
          <svg
            class="icon icon-sun"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4" />
            <path
              d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"
            />
          </svg>
          <svg
            class="icon icon-moon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
          <svg
            class="icon icon-auto"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="4" width="18" height="12" rx="2" />
            <path d="M8 20h8M12 16v4" />
          </svg>
        </button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} Wayne Van Son</p>
      <p class="footer-links">
        <a href="/rss.xml">RSS</a>
        <a href="/keystatic">Admin</a>
      </p>
    </footer>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const button = document.querySelector('[data-theme-toggle]');
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
        const nextMode = { system: 'light', light: 'dark', dark: 'system' };

        const readStored = () => {
          try {
            const value = localStorage.getItem('theme');
            return value === 'light' || value === 'dark' || value === 'system'
              ? value
              : null;
          } catch {
            return null;
          }
        };

        let mode = readStored() ?? 'system';

        const apply = (next) => {
          const resolved =
            next === 'system' ? (systemDark.matches ? 'dark' : 'light') : next;
          root.dataset.theme = resolved;
          root.dataset.themeMode = next;
          if (!button) return;

          const target = nextMode[next];
          const label =
            target === 'light'
              ? 'Switch to light theme'
              : target === 'dark'
                ? 'Switch to dark theme'
                : 'Use the system theme';
          button.setAttribute('aria-label', label);
          button.setAttribute('title', label);
        };

        apply(mode);

        button?.addEventListener('click', () => {
          mode = nextMode[mode];
          apply(mode);
          try {
            localStorage.setItem('theme', mode);
          } catch {}
        });

        // Follow system changes until the visitor picks light or dark.
        systemDark.addEventListener('change', () => {
          if (mode !== 'system') return;
          apply(mode);
        });
      })();
    </script>
  </body>
</html>
